# Configuration SMTP pour OVH MX Plan
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=votre-email@votre-domaine.com
SMTP_PASS=votre-mot-de-passe

# Email de réception des messages de contact
CONTACT_EMAIL=votre-email@votre-domaine.com

# URL de base du site (utilisée pour le SEO, le sitemap et les données structurées)
NEXT_PUBLIC_BASE_URL=https://www.tipaix.fr

# Code de vérification Google Search Console (optionnel)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Sanity (back office)
NEXT_PUBLIC_SANITY_PROJECT_ID=r40iuo36
NEXT_PUBLIC_SANITY_DATASET=production

# Token de lecture (Live Content API + édition visuelle + aperçu des brouillons)
SANITY_API_READ_TOKEN=